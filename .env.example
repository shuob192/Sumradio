# All paths are relative to the directory where sumradio is started.
SUMRADIO_DATA_DIR=data
SUMRADIO_DEVICE=cpu
SUMRADIO_FINAL_MODEL=medium
SUMRADIO_PARTIAL_MODEL=medium
SUMRADIO_MODEL_DIR=models
# Initial setup downloads models: uv run --extra audio sumradio setup
SUMRADIO_OFFLINE=true
SUMRADIO_PROFILE=raw
SUMRADIO_SILENCE_SECONDS=1.0
SUMRADIO_ENERGY_THRESHOLD=0.012
SUMRADIO_MIN_SPEECH_SECONDS=0.2
SUMRADIO_PREROLL_SECONDS=0.3
SUMRADIO_MAX_SECONDS=30
SUMRADIO_PARTIAL_INTERVAL=0.75
SUMRADIO_PARTIAL_WINDOW=6
SUMRADIO_DENOISE_STRENGTH=0.15
# Set 50 or 60 only after measuring hum; 0 disables the notch.
SUMRADIO_NOTCH_HZ=0
SUMRADIO_RADIO_MODE=true
SUMRADIO_USE_PROMPT=true
SUMRADIO_AUTO_EXTRACT=true
